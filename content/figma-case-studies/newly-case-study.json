          },
          {
            "_type": "block",
            "_key": "newly-s-3-b-3",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "newly-s-3-b-3-s",
                "marks": [],
                "text": "So the modes moved into the bar as a segmented control, and only the active one shows its label:"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "newly-s-3-b-4-0",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
