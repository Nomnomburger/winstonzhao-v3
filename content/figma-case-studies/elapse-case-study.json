                "marks": [],
                "text": "Summary"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "elapse-s-6-b-6",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-6-b-6-s",
                "marks": [],
                "text": "Elapse started from problems I ran into while competing. The official app spread the schedule across screens, and schedules didn’t update when matches ran late. I was co-founder and the only designer, working with seven developers. I designed an app that puts your next match first, updates the schedule when matches run late, and has a mode built for tournament day."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "elapse-s-6-b-7",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-6-b-7-s",
                "marks": [],
                "text": "It launched on iOS in November 2024, is also on Android, and has 4,000+ accounts and a 4.8-star rating."
              }
            ]
          }
        ]
      }
