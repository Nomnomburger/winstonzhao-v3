            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-1-b-1-0-s",
                "marks": [
                  "strong"
                ],
                "text": "Planned:"
              },
              {
                "_type": "span",
                "_key": "elapse-s-1-b-1-0-s1",
                "marks": [],
                "text": " an organizer portal for delays and announcements, a chatbot, and a web app for phones, tablets and computers."
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "elapse-s-1-b-1-1",
            "style": "normal",
