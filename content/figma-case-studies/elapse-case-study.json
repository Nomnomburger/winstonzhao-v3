          },
          {
            "_type": "block",
            "_key": "elapse-s-3-b-1",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-3-b-1-s",
                "marks": [],
                "text": "Instead of quietly changing the time, the app shows the new time with “Delayed - originally …”, and finished matches show how late they started."
              }
            ]
          },
          {
            "_type": "mediaImage",
            "_key": "elapse-s-3-b-2",
            "localAssetKey": "delays",
            "alt": "Two iPhones: Your Next Match with “Delayed - originally” under the new time, and a finished match that started 3 minutes late",
            "caption": "A delayed match, and a finished one that started late.",
            "size": "full"
          }
        ]
