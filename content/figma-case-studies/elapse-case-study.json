            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-0-b-1-2-s",
                "marks": [],
                "text": "Announcements over the mic were easy to miss."
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "elapse-s-0-b-2",
