            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-1-b-1-1-s",
                "marks": [
                  "strong"
                ],
                "text": "Shipped:"
              },
              {
                "_type": "span",
                "_key": "elapse-s-1-b-1-1-s1",
                "marks": [],
                "text": " tournament mode, upcoming matches and live timing."
