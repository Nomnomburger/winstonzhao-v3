            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-0-b-1-0-s",
                "marks": [],
                "text": "The official schedule app took several taps and spread information across screens."
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "elapse-s-0-b-1-1",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-0-b-1-1-s",
                "marks": [],
                "text": "Schedules weren’t updated when matches ran late."
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "elapse-s-0-b-1-2",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-0-b-1-2-s",
                "marks": [],
                "text": "Announcements over the mic were easy to miss."
              }
            ],
            "listItem": "bullet",
            "level": 1
          },
          {
            "_type": "block",
            "_key": "elapse-s-0-b-2",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-0-b-2-s",
                "marks": [],
                "text": "Elapse started from those problems."
              }
            ]
          }
        ]
