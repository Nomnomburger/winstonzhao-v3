                "_key": "elapse-s-2-b-1-0-s",
                "marks": [
                  "strong"
                ],
                "text": "Time is what you act on:"
              },
              {
                "_type": "span",
                "_key": "elapse-s-2-b-1-0-s1",
                "marks": [],
                "text": " it tells you when to head to the field."
