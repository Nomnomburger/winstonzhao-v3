            "_key": "elapse-s-3-b-1",
            "style": "normal",
            "markDefs": [],
            "children": [
              {
                "_type": "span",
                "_key": "elapse-s-3-b-1-s",
                "marks": [],
                "text": "Instead of quietly changing the time, the app shows the new time with “Delayed – originally …”. Finished matches show “Started 3 mins late”."
              }
            ]
          },
